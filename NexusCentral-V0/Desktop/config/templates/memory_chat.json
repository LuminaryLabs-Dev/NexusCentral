      "required": true,
      "maps_to": "prompt"
    }
  ],
  "artifact_outputs": {
    "discover": true,
    "globs": [
      "**/*.md",
      "**/*.txt"
    ]
  },
  "default_model_id": "",
  "default_max_tokens": 1200,
  "default_args": [],
  "tags": [
    "chat",
    "memory",
    "nexusglmharness"
  ]
}
