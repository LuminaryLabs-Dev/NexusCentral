{
  "id": "memory_chat",
  "name": "Memory Chat",
  "description": "NexusGLMHarness chat with harness-owned memory search.",
  "default_mode": "wrapper",
  "default_wrapper_id": "nexusglmharness",
  "allowed_wrapper_ids": [
    "nexusglmharness",
    "nexusagent",
    "direct_llm"
  ],
  "wrapper_locked": false,
