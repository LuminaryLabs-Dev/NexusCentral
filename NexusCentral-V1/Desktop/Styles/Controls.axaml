<Styles xmlns="https://github.com/avaloniaui">
  <Style Selector="Button">
    <Setter Property="Background" Value="{DynamicResource PanelAltBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="{DynamicResource CompactPadding}" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button:pointerover">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrightBrush}" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="#07100F" />
  </Style>

  <Style Selector="Button.primary:pointerover">
    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
  </Style>

  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="{DynamicResource PanelAltBrush}" />
  </Style>

  <Style Selector="Button.headerAction">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="10,5" />
  </Style>

  <Style Selector="ToggleButton.headerAction">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="10,5" />
  </Style>

  <Style Selector="ToggleButton.headerAction:checked">
    <Setter Property="Background" Value="{DynamicResource SelectedBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrightBrush}" />
  </Style>

  <Style Selector="ListBox.topNav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="ListBox.topNav ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="ListBox.topNav ListBoxItem:selected">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Border.surfaceMenuHost">
    <Setter Property="Background" Value="{DynamicResource PanelAltBrush}" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="MinHeight" Value="48" />
  </Style>

  <Style Selector="Border.surfaceMenuHost:pointerover">
    <Setter Property="Background" Value="{DynamicResource SelectedBackgroundBrush}" />
  </Style>

  <Style Selector="Border.surfaceMenuPopup">
    <Setter Property="Background" Value="{DynamicResource PanelAltBrush}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="48" />
  </Style>

  <Style Selector="ListBox.surfaceMenuList">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="ListBox.surfaceMenuList ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="ListBox.surfaceMenuList ListBoxItem:selected">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Border.navTab">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="MinWidth" Value="122" />
    <Setter Property="MinHeight" Value="48" />
  </Style>

  <Style Selector="Border.navTab:pointerover">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
  </Style>

  <Style Selector="Border.navTab.selected">
    <Setter Property="Background" Value="{DynamicResource PanelAltBrush}" />
  </Style>

  <Style Selector="Border.navGlyph">
    <Setter Property="Background" Value="{DynamicResource InputBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="5,3" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.navGlyphText">
    <Setter Property="FontFamily" Value="Cascadia Code, Consolas, monospace" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}" />
  </Style>

  <Style Selector="TextBlock.navText">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>

  <Style Selector="TextBlock.navMeta">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
  </Style>

  <Style Selector="Border.metricBadge">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="{DynamicResource BadgePadding}" />
  </Style>

  <Style Selector="TextBlock.metricLabel">
    <Setter Property="FontSize" Value="9" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
  </Style>

  <Style Selector="TextBlock.metricValue">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrightBrush}" />
  </Style>

  <Style Selector="Button.iconButton">
    <Setter Property="MinWidth" Value="34" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>

  <Style Selector="Button.wideAction">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>

  <Style Selector="ListBox.rightNav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="ListBox.rightNav ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,0,8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="ListBox.rightNav ListBoxItem:selected">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="ListBox.flatList">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="ListBox.flatList ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="ListBox.flatList ListBoxItem:selected">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Border.rightNavItem">
    <Setter Property="Padding" Value="6,6" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="2,0,0,0" />
  </Style>

  <Style Selector="Border.rightNavItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
  </Style>

  <Style Selector="Border.rightNavItem.selected">
    <Setter Property="Background" Value="{DynamicResource SelectedBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
  </Style>

  <Style Selector="TextBlock.statusPaneTitle">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrightBrush}" />
  </Style>

  <Style Selector="TextBlock.statusPaneValue">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrightBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style Selector="TextBlock.statusPaneMeta">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style Selector="TextBlock.topDivider">
    <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
  </Style>

  <Style Selector="TextBlock.topMeta">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>

  <Style Selector="TextBlock.topStatusReady">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource StatusReadyBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.sessionName">
    <Setter Property="FontFamily" Value="Cascadia Code, Consolas, monospace" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>

  <Style Selector="TextBlock.transcriptText">
    <Setter Property="FontFamily" Value="Cascadia Code, Consolas, monospace" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="18" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Margin" Value="0,0,0,10" />
  </Style>

  <Style Selector="TextBlock.dockTitle">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrightBrush}" />
  </Style>

  <Style Selector="TextBlock.dockChip">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="Padding" Value="10,4" />
  </Style>

  <Style Selector="TextBlock.consoleMuted">
    <Setter Property="FontFamily" Value="Cascadia Code, Consolas, monospace" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
  </Style>

  <Style Selector="TextBlock.consoleLevel">
    <Setter Property="FontFamily" Value="Cascadia Code, Consolas, monospace" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource StatusReadyBrush}" />
  </Style>

  <Style Selector="TextBlock.consoleSource">
    <Setter Property="FontFamily" Value="Cascadia Code, Consolas, monospace" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}" />
  </Style>

  <Style Selector="TextBlock.consoleText">
    <Setter Property="FontFamily" Value="Cascadia Code, Consolas, monospace" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>

  <Style Selector="TextBlock.dockCardTitle">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>

  <Style Selector="TextBlock.dockCardValue">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrightBrush}" />
  </Style>

  <Style Selector="TextBlock.dockCardMeta">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>

  <Style Selector="TextBlock.footerStatus">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource StatusReadyBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.footerText">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.footerChip">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrightBrush}" />
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
</Styles>
