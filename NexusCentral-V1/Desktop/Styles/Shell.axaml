<Styles xmlns="https://github.com/avaloniaui">
  <Style Selector="Grid.shellRoot">
    <Setter Property="Background" Value="{DynamicResource ShellBackgroundBrush}" />
  </Style>

  <Style Selector="Border.shellTopStrip">
    <Setter Property="Background" Value="{DynamicResource HeaderBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="{DynamicResource ShellPadding}" />
  </Style>

  <Style Selector="Grid.workspaceFrame">
    <Setter Property="Margin" Value="0" />
  </Style>

  <Style Selector="Border.workspacePane">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>

  <Style Selector="Border.pageHeader">
    <Setter Property="Background" Value="{DynamicResource HeaderBackgroundBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="16,12" />
  </Style>

  <Style Selector="Border.surfaceHero">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="18" />
  </Style>

  <Style Selector="Border.sectionCard">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="14" />
  </Style>

  <Style Selector="Border.sectionCard.subtle">
    <Setter Property="Background" Value="{DynamicResource SubtleCardBackgroundBrush}" />
  </Style>

  <Style Selector="Border.splitPreview">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Border.flatToolbar">
    <Setter Property="Background" Value="{DynamicResource HeaderBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="12,9" />
  </Style>

  <Style Selector="Border.flatLane">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
    <Setter Property="Padding" Value="10" />
  </Style>

  <Style Selector="Border.flatLane.right">
    <Setter Property="BorderThickness" Value="1,0,0,0" />
  </Style>

  <Style Selector="Border.flatMainLane">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="12" />
  </Style>

  <Style Selector="Border.flatComposer">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="10" />
  </Style>

  <Style Selector="Border.flatStatusStrip">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="8" />
  </Style>

  <Style Selector="Border.flatListRow">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,7" />
  </Style>

  <Style Selector="Border.flatListRow.selected">
    <Setter Property="Background" Value="{DynamicResource SelectedBackgroundBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Border.flatBlock">
    <Setter Property="Background" Value="{DynamicResource SubtleCardBackgroundBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="10" />
  </Style>

  <Style Selector="Border.statusDockBar">
    <Setter Property="Background" Value="{DynamicResource ShellBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="8,4" />
  </Style>

  <Style Selector="Border.consolePanel">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Height" Value="220" />
  </Style>

  <Style Selector="Border.finalTopBar">
    <Setter Property="Background" Value="{DynamicResource HeaderBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="12,0" />
  </Style>

  <Style Selector="Grid.finalWorkspace">
    <Setter Property="Margin" Value="0" />
  </Style>

  <Style Selector="Border.rightNavRail">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
    <Setter Property="Padding" Value="10,10" />
  </Style>

  <Style Selector="Border.rightSidebar">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="Border.shellStatusRail">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="Border.statusStack">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="Border.sidebarSection">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="16,14" />
  </Style>

  <Style Selector="Border.tabsSection">
    <Setter Property="MinHeight" Value="176" />
  </Style>

  <Style Selector="Border.statusPane">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="16,14" />
  </Style>

  <Style Selector="TextBlock.railCollapse">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="FontFamily" Value="Cascadia Code, Consolas, monospace" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <Style Selector="Grid.labRoot">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Border.labWorkspaceLane">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="0,0,1,1" />
    <Setter Property="Padding" Value="12" />
  </Style>

  <Style Selector="Border.labChatLane">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>

  <Style Selector="Border.sessionHeader">
    <Setter Property="Background" Value="{DynamicResource HeaderBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="14,0" />
  </Style>

  <Style Selector="ScrollViewer.transcriptScroll">
    <Setter Property="Padding" Value="22,12" />
  </Style>

  <Style Selector="Border.composerBar">
    <Setter Property="Background" Value="{DynamicResource HeaderBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="12" />
  </Style>

  <Style Selector="Border.attachmentPill">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="Margin" Value="0,0,6,0" />
  </Style>

  <Style Selector="Border.treeRow">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="4,3" />
  </Style>

  <Style Selector="Border.treeRow:pointerover">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
  </Style>

  <Style Selector="Border.finalStatusDock">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Margin" Value="0" />
  </Style>

  <Style Selector="Border.dockHeader">
    <Setter Property="Background" Value="{DynamicResource HeaderBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="12,0" />
  </Style>

  <Style Selector="Border.consoleTable">
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Border.dockCard">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
    <Setter Property="Padding" Value="14,10" />
  </Style>

  <Style Selector="Border.finalFooter">
    <Setter Property="Background" Value="{DynamicResource ShellBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="12,0" />
  </Style>
</Styles>
