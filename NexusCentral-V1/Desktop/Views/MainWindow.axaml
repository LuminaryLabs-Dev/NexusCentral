<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NexusCentral.V1.Desktop.ViewModels"
        xmlns:components="using:NexusCentral.V1.Desktop.Components"
        xmlns:backgrounds="using:NexusCentral.V1.Desktop.Backgrounds"
        x:Class="NexusCentral.V1.Desktop.Views.MainWindow"
        x:DataType="vm:MainShellViewModel"
        Title="NexusCentral V1"
        Width="1280"
        Height="820"
        MinWidth="1024"
        MinHeight="680"
        WindowStartupLocation="CenterScreen">
  <Grid x:Name="ShellRoot"
        RowDefinitions="42,*,30"
        ColumnDefinitions="*"
        Classes="shellRoot"
        PointerMoved="ShellRootPointerMoved"
        PointerExited="ShellRootPointerExited">
    <backgrounds:MosaicShaderBackground x:Name="ShellBackground"
                                         Grid.RowSpan="3"
                                         IsHitTestVisible="False" />

    <Border Grid.Row="0"
            Classes="finalTopBar">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto"
            ColumnSpacing="14">
        <StackPanel Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="10"
                    VerticalAlignment="Center">
          <TextBlock Text="NexusCentral V1"
                     Classes="appTitle" />
          <TextBlock Text="|"
                     Classes="topDivider" />
          <TextBlock Text="Modular control plane"
                     Classes="appSubtitle" />
        </StackPanel>

        <StackPanel Grid.Column="3"
                    Orientation="Horizontal"
                    Spacing="10"
                    VerticalAlignment="Center">
          <TextBlock Text="{Binding FooterWorkspaceText, StringFormat='Workspace  {0}'}"
                     Classes="topMeta" />
          <ComboBox Width="190"
                    ItemsSource="{Binding Surfaces}"
                    SelectedItem="{Binding SelectedSurface, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
              <DataTemplate DataType="vm:NavigationItemViewModel">
                <StackPanel Orientation="Horizontal"
                            Spacing="8">
                  <TextBlock Text="{Binding Glyph}"
                             Classes="navGlyphText" />
                  <TextBlock Text="{Binding Name}"
                             Classes="navText" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1"
          Classes="finalWorkspace">
      <Border Classes="workspacePane">
        <ContentControl Content="{Binding SelectedSurface}" />
      </Border>
    </Grid>

    <Border Grid.Row="2"
            Classes="finalFooter">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto"
            ColumnSpacing="14">
        <TextBlock Text="{Binding AppStatusText, StringFormat='Status  {0}'}"
                   Classes="footerStatus" />
        <TextBlock Grid.Column="1"
                   Text="{Binding ModeLabel}"
                   Classes="footerText" />
        <TextBlock Grid.Column="2"
                   Text="{Binding SetupReadinessText}"
                   Classes="footerChip" />
        <Button Grid.Column="3"
                Classes="headerAction"
                Content="{Binding SetupActionText}"
                Command="{Binding ResolveSetupCommand}" />
        <TextBlock Grid.Column="4"
                   Text="{Binding RouteStatusText}"
                   Classes="footerText" />
        <TextBlock Grid.Column="5"
                   Text="{Binding ModelStatusText}"
                   Classes="footerText" />
      </Grid>
    </Border>
  </Grid>
</Window>
