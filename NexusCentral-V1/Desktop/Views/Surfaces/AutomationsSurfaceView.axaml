<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NexusCentral.V1.Desktop.ViewModels"
             xmlns:components="using:NexusCentral.V1.Desktop.Components"
             x:Class="NexusCentral.V1.Desktop.Views.Surfaces.AutomationsSurfaceView"
             x:DataType="vm:NavigationItemViewModel">
  <Grid RowDefinitions="Auto,*">
    <Border Classes="flatToolbar">
      <Grid ColumnDefinitions="*,Auto"
            ColumnSpacing="10">
        <StackPanel Spacing="2">
          <TextBlock Text="Automations"
                     Classes="sectionTitle" />
          <TextBlock Text="{Binding CapabilitySummary}"
                     Classes="sectionMeta"
                     TextWrapping="Wrap" />
        </StackPanel>
        <components:MetricBadge Grid.Column="1"
                                Label="State"
                                Value="{Binding StatusLabel}"
                                AccentBrush="{DynamicResource StatusWaitingBrush}"
                                BackgroundBrush="{DynamicResource BadgeAmberBackgroundBrush}" />
      </Grid>
    </Border>

    <Border Grid.Row="1"
            Classes="flatMainLane">
      <StackPanel Spacing="8">
        <TextBlock Text="Workflow runner is not active yet."
                   Classes="pageTitle" />
        <TextBlock Text="Workflow lists, ladders, run history, and artifacts stay out of the main screen until the automation service owns real state."
                   Classes="sectionMeta"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
