<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NexusCentral.V3.Desktop.ViewModels"
             xmlns:components="using:NexusCentral.V3.Desktop.Components"
             x:Class="NexusCentral.V3.Desktop.Views.Surfaces.AutomationsSurfaceView"
             x:DataType="vm:NavigationItemViewModel">
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0"
            Classes="flatToolbar">
      <StackPanel Orientation="Horizontal"
                  Spacing="8"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center">
        <components:MetricBadge Label="Workflows"
                                Value="{Binding StatusLabel}"
                                AccentBrush="{DynamicResource StatusWaitingBrush}"
                                BackgroundBrush="{DynamicResource BadgeAmberBackgroundBrush}" />
        <Button Classes="primary"
                IsEnabled="False"
                Content="{Binding PrimaryActionLabel}" />
        <Button Classes="secondary"
                IsEnabled="False"
                Content="{Binding SecondaryActionLabel}" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="1"
          ColumnDefinitions="300,*">
      <Border Classes="flatLane">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Text="Workflow list"
                     Classes="sectionTitle" />
          <StackPanel Grid.Row="1"
                      Margin="0,8,0,0"
                      Spacing="0">
            <Border Classes="flatListRow selected">
              <StackPanel Spacing="2">
                <TextBlock Text="Untitled ladder"
                           Classes="sectionTitle" />
                <TextBlock Text="Draft automation placeholder"
                           Classes="caption" />
              </StackPanel>
            </Border>
            <Border Classes="flatListRow">
              <TextBlock Text="Validation queue placeholder"
                         Classes="sectionMeta" />
            </Border>
            <Border Classes="flatListRow">
              <TextBlock Text="Run history placeholder"
                         Classes="sectionMeta" />
            </Border>
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Column="1"
              Classes="flatMainLane">
        <Grid RowDefinitions="Auto,*"
              RowSpacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Text="Ladder editor"
                         Classes="sectionTitle" />
              <TextBlock Text="{Binding CapabilitySummary}"
                         Classes="sectionMeta"
                         TextWrapping="Wrap" />
            </StackPanel>
            <components:MetricBadge Grid.Column="1"
                                    Label="Run"
                                    Value="not running"
                                    AccentBrush="{DynamicResource StatusOfflineBrush}"
                                    BackgroundBrush="{DynamicResource BadgeGrayBackgroundBrush}" />
          </Grid>

          <StackPanel Grid.Row="1"
                      Spacing="8">
            <Border Classes="flatBlock">
              <TextBlock Text="Step 1 - Prompt input placeholder"
                         Classes="sectionTitle" />
            </Border>
            <Border Classes="flatBlock">
              <TextBlock Text="Step 2 - Model or harness selection placeholder"
                         Classes="sectionTitle" />
            </Border>
            <Border Classes="flatBlock">
              <TextBlock Text="Step 3 - Artifact output placeholder"
                         Classes="sectionTitle" />
            </Border>
          </StackPanel>

        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2"
            Classes="flatStatusStrip">
      <TextBlock Text="Run output/artifacts placeholder: stdout, generated files, YAML export status, and validation errors."
                 Classes="sectionMeta" />
    </Border>
  </Grid>
</UserControl>
