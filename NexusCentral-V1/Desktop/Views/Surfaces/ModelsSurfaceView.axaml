<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:NexusCentral.V1.Features.Models"
             xmlns:components="using:NexusCentral.V1.Desktop.Components"
             x:Class="NexusCentral.V1.Desktop.Views.Surfaces.ModelsSurfaceView"
             x:DataType="models:ModelsViewModel">
  <Grid ColumnDefinitions="360,*">
    <Border Classes="flatLane">
      <Grid RowDefinitions="Auto,Auto,Auto,*"
            RowSpacing="10">
        <StackPanel Spacing="2">
          <TextBlock Text="Model endpoints"
                     Classes="sectionTitle" />
          <TextBlock Text="Add routable model endpoints. Probing only reads /models; it does not download models."
                     Classes="sectionMeta"
                     TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1"
                Classes="flatBlock">
          <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                RowSpacing="7">
            <TextBox Text="{Binding NewEndpointName, Mode=TwoWay}"
                     PlaceholderText="Endpoint name" />
            <TextBox Grid.Row="1"
                     Text="{Binding NewEndpointBaseUrl, Mode=TwoWay}"
                     PlaceholderText="Base URL" />
            <TextBox Grid.Row="2"
                     Text="{Binding NewEndpointModelId, Mode=TwoWay}"
                     PlaceholderText="Selected model id" />
            <Grid Grid.Row="3"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="8">
              <TextBlock Text="{Binding NewEndpointStatusText}"
                         Classes="caption"
                         TextWrapping="Wrap"
                         VerticalAlignment="Center" />
              <Button Grid.Column="1"
                      Classes="primary"
                      Content="Add"
                      Command="{Binding AddEndpointCommand}" />
            </Grid>
          </Grid>
        </Border>

        <Grid Grid.Row="2"
              ColumnDefinitions="Auto,*,Auto,Auto"
              ColumnSpacing="8">
          <TextBlock Text="State"
                     Classes="sectionMeta"
                     VerticalAlignment="Center" />
          <TextBlock Grid.Column="1"
                     Text="{Binding StatusLabel}"
                     Classes="sectionTitle"
                     VerticalAlignment="Center" />
          <Button Grid.Column="2"
                  Classes="secondary"
                  Content="Probe"
                  Command="{Binding ProbeSelectedEndpointCommand}" />
          <Button Grid.Column="3"
                  Classes="secondary"
                  Content="Remove"
                  Command="{Binding RemoveSelectedEndpointCommand}" />
        </Grid>

        <ListBox Grid.Row="3"
                 Classes="flatList"
                 ItemsSource="{Binding Endpoints}"
                 SelectedItem="{Binding SelectedEndpoint, Mode=TwoWay}">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="models:ModelEndpointItemViewModel">
              <Border Classes="flatListRow">
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding DisplayName}"
                             Classes="sectionTitle" />
                  <TextBlock Text="{Binding ProviderLabel}"
                             Classes="caption" />
                  <TextBlock Text="{Binding HealthLabel}"
                             Classes="caption" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <Border Grid.Column="1"
            Classes="flatMainLane">
      <Grid RowDefinitions="Auto,Auto,*"
            RowSpacing="10">
        <Grid ColumnDefinitions="*,Auto"
              ColumnSpacing="8">
          <StackPanel Spacing="2">
            <TextBlock Text="Selected endpoint"
                       Classes="sectionTitle" />
            <TextBlock Text="{Binding ActiveEndpointDetail}"
                       Classes="sectionMeta"
                       TextWrapping="Wrap" />
          </StackPanel>
          <components:MetricBadge Grid.Column="1"
                                  Label="Health"
                                  Value="{Binding ActiveEndpointHealthText}"
                                  AccentBrush="{DynamicResource StatusWaitingBrush}"
                                  BackgroundBrush="{DynamicResource BadgeAmberBackgroundBrush}" />
        </Grid>

        <Border Grid.Row="1"
                Classes="flatBlock">
          <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                RowSpacing="10">
            <TextBlock Text="{Binding ActiveEndpointTitle}"
                       Classes="pageTitle" />
            <TextBlock Grid.Row="1"
                       Text="{Binding ActiveEndpointModelText}"
                       Classes="sectionTitle" />
            <TextBlock Grid.Row="2"
                       Text="{Binding ActiveEndpointBaseUrl}"
                       Classes="sectionMeta"
                       TextWrapping="Wrap" />
            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        Spacing="8">
              <components:MetricBadge Label="State"
                                      Value="{Binding ActiveEndpointHealthText}"
                                      AccentBrush="{DynamicResource StatusWaitingBrush}"
                                      BackgroundBrush="{DynamicResource BadgeAmberBackgroundBrush}" />
              <components:MetricBadge Label="Models"
                                      Value="{Binding ActiveEndpointModelCountText}"
                                      AccentBrush="{DynamicResource StatusActiveBrush}"
                                      BackgroundBrush="{DynamicResource BadgeBlueBackgroundBrush}" />
              <components:MetricBadge Label="Probe"
                                      Value="{Binding ActiveEndpointLastProbeText}"
                                      AccentBrush="{DynamicResource StatusReadyBrush}"
                                      BackgroundBrush="{DynamicResource BadgeGreenBackgroundBrush}" />
            </StackPanel>
            <TextBlock Grid.Row="4"
                       Text="{Binding RuntimeStatusText}"
                       Classes="sectionMeta"
                       TextWrapping="Wrap" />
            <TextBlock Grid.Row="5"
                       Text="{Binding ContextStatusText}"
                       Classes="sectionMeta"
                       TextWrapping="Wrap" />
          </Grid>
        </Border>

        <Expander Grid.Row="2"
                  Header="Public model search (no downloads)">
          <Grid RowDefinitions="Auto,Auto,*"
                RowSpacing="8"
                Margin="0,8,0,0">
            <Grid ColumnDefinitions="*,Auto,Auto"
                  ColumnSpacing="8">
              <TextBox Text="{Binding HubSearch.Query, Mode=TwoWay}"
                       PlaceholderText="Search Hugging Face models" />
              <Button Grid.Column="1"
                      Classes="primary"
                      Content="Search"
                      Command="{Binding HubSearch.SearchCommand}" />
              <Button Grid.Column="2"
                      Classes="secondary"
                      Content="Clear"
                      Command="{Binding HubSearch.ClearCommand}" />
            </Grid>

            <TextBlock Grid.Row="1"
                       Text="{Binding HubSearch.StatusLabel}"
                       Classes="sectionMeta" />

            <ListBox Grid.Row="2"
                     Classes="flatList"
                     MaxHeight="260"
                     ItemsSource="{Binding HubSearch.Results}"
                     SelectedItem="{Binding HubSearch.SelectedResult, Mode=TwoWay}">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="models:HuggingFaceModelSearchItemViewModel">
                  <Border Classes="flatListRow">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding Title}"
                                 Classes="sectionTitle" />
                      <TextBlock Text="{Binding MetaText}"
                                 Classes="caption"
                                 TextWrapping="Wrap" />
                      <TextBlock Text="{Binding StatsText}"
                                 Classes="caption" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Expander>
      </Grid>
    </Border>
  </Grid>
</UserControl>
