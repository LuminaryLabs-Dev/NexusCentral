<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:router="using:NexusCentral.V1.Features.Router"
             xmlns:components="using:NexusCentral.V1.Desktop.Components"
             x:Class="NexusCentral.V1.Desktop.Views.Surfaces.RouterSurfaceView"
             x:DataType="router:RouterViewModel">
  <Grid RowDefinitions="*">
    <Grid ColumnDefinitions="340,*">
      <Border Classes="flatLane">
        <Grid RowDefinitions="Auto,Auto,*"
              RowSpacing="8">
          <Grid ColumnDefinitions="*,Auto,Auto"
                ColumnSpacing="8">
            <StackPanel Spacing="2">
              <TextBlock Text="Routes"
                         Classes="sectionTitle" />
              <TextBlock Text="{Binding CapabilitySummary}"
                         Classes="sectionMeta"
                         TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1"
                    Classes="secondary"
                    Content="Refresh"
                    Command="{Binding RefreshCommand}" />
            <Button Grid.Column="2"
                    Classes="primary"
                    Content="Select best"
                    Command="{Binding SelectBestRouteCommand}" />
          </Grid>

          <Grid Grid.Row="1"
                ColumnDefinitions="Auto,*"
                ColumnSpacing="8">
            <TextBlock Text="State"
                       Classes="sectionMeta"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1"
                       Text="{Binding StatusLabel}"
                       Classes="sectionTitle"
                       VerticalAlignment="Center" />
          </Grid>

          <ListBox Grid.Row="2"
                   Classes="flatList"
                   ItemsSource="{Binding Routes}"
                   SelectedItem="{Binding SelectedRoute, Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="router:RouterRouteItemViewModel">
                <Border Classes="flatListRow">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding DisplayName}"
                               Classes="sectionTitle" />
                    <TextBlock Text="{Binding TargetKind}"
                               Classes="caption" />
                    <TextBlock Text="{Binding AvailabilityLabel}"
                               Classes="caption" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <Border Grid.Column="1"
              Classes="flatMainLane">
        <Grid RowDefinitions="Auto,*"
              RowSpacing="10">
          <Grid ColumnDefinitions="*,Auto"
                ColumnSpacing="8">
            <StackPanel Spacing="2">
              <TextBlock Text="Selected route"
                         Classes="sectionTitle" />
              <TextBlock Text="{Binding ActiveRouteDetail}"
                         Classes="sectionMeta"
                         TextWrapping="Wrap" />
            </StackPanel>
            <components:MetricBadge Grid.Column="1"
                                    Label="Route"
                                    Value="{Binding ActiveRouteHealthText}"
                                    AccentBrush="{DynamicResource StatusWaitingBrush}"
                                    BackgroundBrush="{DynamicResource BadgeAmberBackgroundBrush}" />
          </Grid>

          <Grid Grid.Row="1"
                RowDefinitions="Auto,Auto,Auto,*"
                RowSpacing="8">
            <Border Classes="flatBlock">
              <Grid ColumnDefinitions="*,Auto"
                    ColumnSpacing="10">
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding ActiveRouteTitle}"
                             Classes="pageTitle" />
                  <TextBlock Text="{Binding ActiveRouteTargetText}"
                             Classes="sectionMeta"
                             TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                  <components:MetricBadge Label="State"
                                          Value="{Binding ActiveRouteHealthText}"
                                          AccentBrush="{DynamicResource StatusWaitingBrush}"
                                          BackgroundBrush="{DynamicResource BadgeAmberBackgroundBrush}" />
                  <components:MetricBadge Label="Queue"
                                          Value="{Binding ActiveRouteQueueText}"
                                          AccentBrush="{DynamicResource StatusActiveBrush}"
                                          BackgroundBrush="{DynamicResource BadgeBlueBackgroundBrush}" />
                  <components:MetricBadge Label="Capacity"
                                          Value="{Binding ActiveRouteCapacityText}"
                                          AccentBrush="{DynamicResource StatusReadyBrush}"
                                          BackgroundBrush="{DynamicResource BadgeGreenBackgroundBrush}" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Grid.Row="1"
                    Classes="flatBlock">
              <StackPanel Spacing="6">
                <TextBlock Text="Queue rule"
                           Classes="sectionTitle" />
                <TextBlock Text="The router reports availability from backed service state: model endpoint health and active hosted harness readiness. Peer overflow and provider fallback ordering are not active in this slice."
                           Classes="sectionMeta"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Grid.Row="2"
                    Classes="flatBlock">
              <Grid RowDefinitions="Auto,Auto,Auto"
                    RowSpacing="7">
                <TextBlock Text="Route smoke"
                           Classes="sectionTitle" />
                <Grid Grid.Row="1"
                      ColumnDefinitions="*,Auto"
                      ColumnSpacing="8">
                  <TextBox Text="{Binding RouteSmokePrompt, Mode=TwoWay}"
                           PlaceholderText="Route smoke prompt" />
                  <Button Grid.Column="1"
                          Classes="primary"
                          Content="Run"
                          Command="{Binding SmokeSelectedRouteCommand}" />
                </Grid>
                <TextBlock Grid.Row="2"
                           Text="{Binding RouteSmokeStatusText}"
                           Classes="sectionMeta"
                           TextWrapping="Wrap" />
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </Border>

    </Grid>
  </Grid>
</UserControl>
