<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NexusCentral.V3.Desktop.ViewModels"
             xmlns:components="using:NexusCentral.V3.Desktop.Components"
             x:Class="NexusCentral.V3.Desktop.Views.Surfaces.SettingsSurfaceView"
             x:DataType="vm:NavigationItemViewModel">
  <Grid RowDefinitions="Auto,*">
    <Border Grid.Row="0"
            Classes="flatToolbar">
      <StackPanel Orientation="Horizontal"
                  Spacing="8"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center">
        <components:MetricBadge Label="Scope"
                                Value="{Binding StatusLabel}"
                                AccentBrush="{DynamicResource StatusOfflineBrush}"
                                BackgroundBrush="{DynamicResource BadgeGrayBackgroundBrush}" />
        <Button Classes="primary"
                IsEnabled="False"
                Content="{Binding PrimaryActionLabel}" />
        <Button Classes="secondary"
                IsEnabled="False"
                Content="{Binding SecondaryActionLabel}" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="1"
          ColumnDefinitions="280,*">
      <Border Classes="flatLane">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Text="Settings groups"
                     Classes="sectionTitle" />
          <StackPanel Grid.Row="1"
                      Margin="0,8,0,0"
                      Spacing="0">
            <Border Classes="flatListRow selected">
              <TextBlock Text="Application"
                         Classes="sectionTitle" />
            </Border>
            <Border Classes="flatListRow">
              <TextBlock Text="Paths"
                         Classes="sectionMeta" />
            </Border>
            <Border Classes="flatListRow">
              <TextBlock Text="Theme"
                         Classes="sectionMeta" />
            </Border>
            <Border Classes="flatListRow">
              <TextBlock Text="Auth references"
                         Classes="sectionMeta" />
            </Border>
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Column="1"
              Classes="flatMainLane">
        <Grid RowDefinitions="Auto,*"
              RowSpacing="10">
          <StackPanel Spacing="2">
            <TextBlock Text="Selected settings editor"
                       Classes="sectionTitle" />
            <TextBlock Text="{Binding CapabilitySummary}"
                       Classes="sectionMeta"
                       TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Row="1"
                      Spacing="8">
            <Border Classes="flatBlock">
              <TextBlock Text="Config profile placeholder"
                         Classes="sectionTitle" />
            </Border>
            <Border Classes="flatBlock">
              <TextBlock Text="Theme and density placeholder"
                         Classes="sectionTitle" />
            </Border>
            <Border Classes="flatBlock">
              <TextBlock Text="Provider auth reference placeholder"
                         Classes="sectionTitle" />
            </Border>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
